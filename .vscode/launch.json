// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"configurations": [
		{
			// Opens dev.code-workspace, not the folder itself: VS Code refuses to
			// open one folder in two windows, so passing ${workspaceFolder} while
			// the repo is already open gives an empty dev host. The workspace file
			// is a distinct window identity over the same folder.
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"${workspaceFolder}/.vscode/dev.code-workspace",
				"--extensionDevelopmentPath=${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			],
			"preLaunchTask": "${defaultBuildTask}"
		},
		{
			// Launches without running any task. Use this when the build task
			// misbehaves, or to isolate a task problem from an extension problem:
			// run `yarn run compile` once in a terminal first, then launch this.
			"name": "Run Extension (no prebuild)",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"${workspaceFolder}/.vscode/dev.code-workspace",
				"--extensionDevelopmentPath=${workspaceFolder}"
			],
			"outFiles": [
				"${workspaceFolder}/dist/**/*.js"
			]
		}
	]
}
