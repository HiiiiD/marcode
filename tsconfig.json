{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node", "mocha"],
        "jsx": "react-jsx",
        "baseUrl": ".",
        "paths": { "@/*": ["src/webview/*"] },
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        "ignoreDeprecations": "6.0",
        "resolveJsonModule": true,
        "skipLibCheck": true
    }
}
