# Build the bundle first (`yarn run compile`), then:
#   docker build -f Dockerfile.sync-server -t marcode-sync .
#   docker run -d -p 8787:8787 -v marcode-sync:/data marcode-sync
# Put HTTPS in front of it (Caddy, a Tailscale serve, a reverse proxy); see docs/sync.md.
FROM node:22-slim
WORKDIR /app
COPY dist/sync-server.js ./sync-server.js
# A named volume copies this ownership, so the unprivileged user can write its database.
RUN mkdir /data && chown node:node /data
VOLUME /data
EXPOSE 8787
USER node
CMD ["node", "sync-server.js", "--data", "/data", "--host", "0.0.0.0", "--port", "8787"]
