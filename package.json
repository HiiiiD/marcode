{
  "name": "hiiiid-code",
  "displayName": "HiiiiD Code",
  "description": "Use your code agents at ease",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hiiiid-code",
          "title": "HiiiiD Code",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "hiiiid-code": [
        {
          "id": "hiiiid-code.panel",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "HiiiiD Code",
      "properties": {
        "hiiiidCode.enabledProviders": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "codex",
              "fake"
            ],
            "enumDescriptions": [
              "Claude Agent SDK.",
              "Codex CLI.",
              "A scripted stand-in that answers without a backend. For development only."
            ]
          },
          "uniqueItems": true,
          "default": [
            "claude",
            "codex"
          ],
          "description": "Which agent providers this window registers. A provider left out is not probed and does not appear in the panel. Takes effect after a window reload.",
          "scope": "window"
        },
        "hiiiidCode.codex.path": {
          "type": "string",
          "default": "",
          "description": "Path to the Codex CLI. Leave empty to use `codex` from PATH."
        }
      }
    },
    "commands": [
      {
        "command": "hiiiidCode.codex.login",
        "title": "HiiiiD Code: Sign in to Codex"
      },
      {
        "command": "hiiiidCode.review.open",
        "title": "HiiiiD Code: Review fleet changes"
      }
    ],
    "walkthroughs": [
      {
        "id": "hiiiid-code.setup",
        "title": "Set up the HiiiiD Code panel",
        "description": "Move the HiiiiD Code panel into the secondary sidebar",
        "steps": [
          {
            "id": "move-to-secondary",
            "title": "Move HiiiiD Code to the secondary sidebar",
            "description": "VS Code extensions cannot place a view in the secondary sidebar directly. Open the secondary sidebar with Ctrl+Alt+B, then drag the HiiiiD Code icon from the activity bar into it. VS Code remembers the location.",
            "media": {
              "markdown": "media/walkthrough-sidebar.md",
              "altText": "Drag HiiiiD Code to the secondary sidebar"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "node esbuild.js && yarn run check-types && yarn run lint",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:css": "tailwindcss -i src/webview/index.css -o dist/webview.css --watch",
    "build:css": "tailwindcss -i src/webview/index.css -o dist/webview.css",
    "package": "yarn run check-types && yarn run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "yarn run pretest && vscode-test",
    "test:unit": "mocha --ui tdd --require tsx/cjs \"src/test/unit/**/*.test.ts\"",
    "test:dom": "mocha --ui tdd --require tsx/cjs --require global-jsdom/register --require src/test/dom/setup.ts \"src/test/dom/**/*.test.tsx\"",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-host.ps1",
    "dev:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-host.ps1 -Clean",
    "codex:bindings": "codex app-server generate-ts --out .codex-bindings"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "global-jsdom": "^29.0.0",
    "jsdom": "^30.0.1",
    "mocha": "^11.8.0",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "packageManager": "yarn@4.18.0",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.228",
    "@base-ui/react": "^1.7.0",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "tailwind-merge": "^3.6.0"
  }
}
