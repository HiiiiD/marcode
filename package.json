{
  "name": "mar-code",
  "displayName": "Marcode",
  "description": "Use your code agents at ease",
  "version": "0.0.51",
  "publisher": "HiiiiD",
  "license": "MIT",
  "icon": "media/marcode-logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiiiiD/marcode.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mar-code",
          "title": "Marcode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mar-code": [
        {
          "id": "mar-code.panel",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Marcode",
      "properties": {
        "marcode.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable additional Marcode diagnostic logging."
        },
        "marcode.showCacheTimer": {
          "type": "boolean",
          "default": false,
          "description": "Show a warm/cold prompt-cache timer badge in the composer, next to the context ring (Claude sessions only). Off by default: the countdown is a client-side approximation anchored when the cache write is observed, not a value confirmed by a later server read, and showing it by default would present that estimate as fact. Takes effect after a window reload."
        },
        "marcode.agentsMdNudge.excludePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra paths the CLAUDE.md/AGENTS.md drift scan skips, on top of the built-in node_modules/.git/dist/out/.claude/worktrees/.worktrees. A plain segment (e.g. \"vendor/legacy\") matches that path anywhere in the tree; an entry containing \"*\" is used as a raw glob.",
          "scope": "window"
        }
      }
    },
    "commands": [
      {
        "command": "marcode.login",
        "title": "Marcode: Sign in to a provider instance"
      },
      {
        "command": "marcode.accountSetup.wizard",
        "title": "Marcode: Set up a provider account"
      },
      {
        "command": "marcode.review.open",
        "title": "Marcode: Review fleet changes"
      },
      {
        "command": "marcode.fleet.open",
        "title": "Marcode: Open fleet view"
      },
      {
        "command": "marcode.history.open",
        "title": "Marcode: Open session history"
      },
      {
        "command": "marcode.memory.reindex",
        "title": "Marcode: Rebuild memory index"
      },
      {
        "command": "marcode.focusPane.1",
        "title": "Marcode: Focus pane 1"
      },
      {
        "command": "marcode.focusPane.2",
        "title": "Marcode: Focus pane 2"
      },
      {
        "command": "marcode.focusPane.3",
        "title": "Marcode: Focus pane 3"
      },
      {
        "command": "marcode.focusPane.4",
        "title": "Marcode: Focus pane 4"
      },
      {
        "command": "marcode.focusPane.5",
        "title": "Marcode: Focus pane 5"
      },
      {
        "command": "marcode.focusPane.6",
        "title": "Marcode: Focus pane 6"
      },
      {
        "command": "marcode.focusPane.7",
        "title": "Marcode: Focus pane 7"
      },
      {
        "command": "marcode.focusPane.8",
        "title": "Marcode: Focus pane 8"
      },
      {
        "command": "marcode.focusPane.9",
        "title": "Marcode: Focus pane 9"
      },
      {
        "command": "marcode.focusNextPane",
        "title": "Marcode: Focus next pane"
      },
      {
        "command": "marcode.focusPrevPane",
        "title": "Marcode: Focus previous pane"
      },
      {
        "command": "marcode.toggleMaximizePane",
        "title": "Marcode: Toggle maximize pane"
      },
      {
        "command": "marcode.config.open",
        "title": "Marcode: Open Config File"
      }
    ],
    "keybindings": [
      {
        "command": "marcode.focusPane.1",
        "key": "alt+1",
        "mac": "ctrl+1",
        "when": "focusedView == 'mar-code.panel'"
      },
      {
        "command": "marcode.focusPane.2",
        "key": "alt+2",
        "mac": "ctrl+2",
        "when": "focusedView == 'mar-code.panel'"
      },
      {
        "command": "marcode.focusPane.3",
        "key": "alt+3",
        "mac": "ctrl+3",
        "when": "focusedView == 'mar-code.panel'"
      },
      {
        "command": "marcode.focusPane.4",
        "key": "alt+4",
        "mac": "ctrl+4",
        "when": "focusedView == 'mar-code.panel'"
      },
      {
        "command": "marcode.focusPane.5",
        "key": "alt+5",
        "mac": "ctrl+5",
        "when": "focusedView == 'mar-code.panel'"
      },
      {
        "command": "marcode.focusPane.6",
        "key": "alt+6",
        "mac": "ctrl+6",
        "when": "focusedView == 'mar-code.panel'"
      },
      {
        "command": "marcode.focusPane.7",
        "key": "alt+7",
        "mac": "ctrl+7",
        "when": "focusedView == 'mar-code.panel'"
      },
      {
        "command": "marcode.focusPane.8",
        "key": "alt+8",
        "mac": "ctrl+8",
        "when": "focusedView == 'mar-code.panel'"
      },
      {
        "command": "marcode.focusPane.9",
        "key": "alt+9",
        "mac": "ctrl+9",
        "when": "focusedView == 'mar-code.panel'"
      },
      {
        "command": "marcode.focusNextPane",
        "key": "alt+pagedown",
        "mac": "ctrl+alt+pagedown",
        "when": "focusedView == 'mar-code.panel'"
      },
      {
        "command": "marcode.focusPrevPane",
        "key": "alt+pageup",
        "mac": "ctrl+alt+pageup",
        "when": "focusedView == 'mar-code.panel'"
      },
      {
        "command": "marcode.toggleMaximizePane",
        "key": "alt+m",
        "mac": "ctrl+m",
        "when": "focusedView == 'mar-code.panel'"
      }
    ],
    "walkthroughs": [
      {
        "id": "mar-code.setup",
        "title": "Set up the Marcode panel",
        "description": "Move the Marcode panel into the secondary sidebar",
        "steps": [
          {
            "id": "move-to-secondary",
            "title": "Move Marcode to the secondary sidebar",
            "description": "VS Code extensions cannot place a view in the secondary sidebar directly. Open the secondary sidebar with Ctrl+Alt+B, then drag the Marcode icon from the activity bar into it. VS Code remembers the location.",
            "media": {
              "markdown": "media/walkthrough-sidebar.md",
              "altText": "Drag Marcode to the secondary sidebar"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "node esbuild.js && yarn run check-types && yarn run check-types:tui && yarn run lint",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:css": "tailwindcss -i src/webview/index.css -o dist/webview.css --watch",
    "build:css": "tailwindcss -i src/webview/index.css -o dist/webview.css",
    "package": "yarn run check-types && yarn run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "check-types": "tsc --noEmit",
    "build:tui": "node scripts/build-tui.mjs",
    "build:tui:bin": "node scripts/build-tui.mjs --compile",
    "check-types:tui": "tsc -p tsconfig.tui.json --noEmit",
    "lint": "eslint src",
    "test": "yarn run pretest && vscode-test",
    "test:unit:raw": "mocha --ui tdd --require tsx/cjs \"src/test/unit/**/*.test.ts\"",
    "test:dom:raw": "mocha --ui tdd --require tsx/cjs --require global-jsdom/register --require src/test/dom/setup.ts \"src/test/dom/**/*.test.tsx\"",
    "test:unit": "node scripts/run-tests-ram-guard.mjs unit",
    "test:tui:raw": "bun test src/test/tui",
    "test:tui": "node scripts/run-tests-ram-guard.mjs tui && node scripts/check-tui-asserts.mjs",
    "test:dom": "node scripts/run-tests-ram-guard.mjs dom",
    "codex:bindings": "codex app-server generate-ts --out .codex-bindings"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@opentui/core": "0.5.13",
    "@opentui/react": "0.5.13",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.12.0",
    "global-jsdom": "^29.0.0",
    "jsdom": "^30.1.1",
    "mocha": "^12.0.3",
    "npm-run-all": "^4.1.5",
    "react-devtools-core": "8.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "web-tree-sitter": "0.25.10",
    "zod": "^4.6.5"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "packageManager": "yarn@4.18.0",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.6.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.288",
    "@base-ui/react": "^1.8.0",
    "@headless-tree/core": "1.7.0",
    "@headless-tree/react": "1.7.0",
    "@opencode-ai/sdk": "^1.18.34",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.7.0"
  }
}
