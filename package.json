{
  "name": "mar-code",
  "displayName": "Marcode",
  "description": "Use your code agents at ease",
  "version": "0.0.4",
  "publisher": "HiiiiD",
  "license": "MIT",
  "icon": "media/marcode-logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiiiiD/marcode.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mar-code",
          "title": "Marcode",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "mar-code": [
        {
          "id": "mar-code.panel",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Marcode",
      "properties": {
        "marcode.enabledProviders": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude",
              "codex",
              "opencode",
              "fake"
            ],
            "enumDescriptions": [
              "Claude Agent SDK.",
              "Codex CLI.",
              "OpenCode CLI, over the Agent Client Protocol.",
              "A scripted stand-in that answers without a backend. For development only."
            ]
          },
          "uniqueItems": true,
          "default": [
            "claude",
            "codex",
            "opencode"
          ],
          "description": "Which agent providers this window registers. A provider left out is not probed and does not appear in the panel. Takes effect after a window reload.",
          "scope": "window"
        },
        "marcode.codex.path": {
          "type": "string",
          "default": "",
          "description": "Path to the Codex CLI. Leave empty to use `codex` from PATH."
        },
        "marcode.opencode.path": {
          "type": "string",
          "default": "",
          "description": "Path to the opencode binary. Empty means use opencode from PATH."
        },
        "marcode.review.fileCap": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "maximum": 2000,
          "description": "How many changed files the review tab loads per working tree before showing a \"Show more\" button. A value over 2000 is clamped; an invalid one falls back to 500. Takes effect after a window reload.",
          "scope": "window"
        },
        "marcode.review.pollIntervalMs": {
          "type": "number",
          "default": 750,
          "minimum": 100,
          "description": "How often, in milliseconds, the review tab re-reads a working tree after it goes dirty. Lower values catch edits sooner at the cost of more frequent git invocations. Takes effect after a window reload.",
          "scope": "window"
        },
        "marcode.review.baseRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra branch names (e.g. \"develop\", \"trunk\") the review tab tries as a working tree's comparison base, after the auto-detected default branch and before the built-in fallbacks (origin/main, origin/master, main, master). Takes effect after a window reload.",
          "scope": "window"
        }
      }
    },
    "commands": [
      {
        "command": "marcode.codex.login",
        "title": "Marcode: Sign in to Codex"
      },
      {
        "command": "marcode.review.open",
        "title": "Marcode: Review fleet changes"
      }
    ],
    "walkthroughs": [
      {
        "id": "mar-code.setup",
        "title": "Set up the Marcode panel",
        "description": "Move the Marcode panel into the secondary sidebar",
        "steps": [
          {
            "id": "move-to-secondary",
            "title": "Move Marcode to the secondary sidebar",
            "description": "VS Code extensions cannot place a view in the secondary sidebar directly. Open the secondary sidebar with Ctrl+Alt+B, then drag the Marcode icon from the activity bar into it. VS Code remembers the location.",
            "media": {
              "markdown": "media/walkthrough-sidebar.md",
              "altText": "Drag Marcode to the secondary sidebar"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "compile": "node esbuild.js && yarn run check-types && yarn run lint",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:css": "tailwindcss -i src/webview/index.css -o dist/webview.css --watch",
    "build:css": "tailwindcss -i src/webview/index.css -o dist/webview.css",
    "package": "yarn run check-types && yarn run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "yarn run compile-tests && yarn run compile && yarn run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "yarn run pretest && vscode-test",
    "test:unit": "mocha --ui tdd --require tsx/cjs \"src/test/unit/**/*.test.ts\"",
    "test:dom": "mocha --ui tdd --require tsx/cjs --require global-jsdom/register --require src/test/dom/setup.ts \"src/test/dom/**/*.test.tsx\"",
    "codex:bindings": "codex app-server generate-ts --out .codex-bindings"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "global-jsdom": "^29.0.0",
    "jsdom": "^30.0.1",
    "mocha": "^11.8.0",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "packageManager": "yarn@4.18.0",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@base-ui/react": "^1.7.0",
    "@headless-tree/core": "1.7.0",
    "@headless-tree/react": "1.7.0",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  }
}
